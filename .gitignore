node_modules/
# Agent worktrees live here. A worktree is a second checkout of this same repo —
# committing it would put a whole duplicate copy of the project inside itself.
#
# Narrowed to the worktrees rather than all of .claude/ on purpose: agent
# definitions, skills and settings belong under .claude/ too, and those ARE worth
# tracking. Ignoring the parent would mean a future .claude/agents/*.md could
# never be committed and nobody would be told why.
.claude/worktrees/
data/commons.db
data/commons.db-journal
data/commons.db-wal
data/commons.db-shm
data/upstream/cache/
# When a card was last produced is a fact about THIS computer, not about the
# commons. It must never travel to another chapter in a clean copy.
data/last-card.json
app/dist/
app/node_modules/
.DS_Store
.env
.env.local

# The ecoregion library.
# The INDEX ships with the repo — it is 314 KB and nothing works without it.
# The DOSSIERS do not: ~100 KB each, ~97 MB for full US coverage, and every byte
# is regenerable with `npm run data`. Putting them in git history would make the
# repository permanently heavy for everyone who only wants their own bioregion.
# To carry them offline, build a portable bundle: npm run data -- --bundle
data/dossiers/
!data/regions/
node_modules

# Backups of the commons. Same reasoning as commons.db itself: this is the
# community's data, not the software.
data/backups/
